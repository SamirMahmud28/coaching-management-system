# Copy to .env (development) and .env.test (tests, pointing at a database whose name ends in _test).
# Never commit .env or .env.test.

NODE_ENV=development

# Local PostgreSQL 16. Databases: cms (development) and cms_test (tests). See README.md for the one-time setup.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cms

# Institute-side and platform-side Better Auth instances use SEPARATE secrets, so a leaked institute
# secret can never forge a platform session. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
PLATFORM_AUTH_SECRET=

# Hosts. In development *.localhost resolves without any hosts-file change (Chrome/Edge):
#   localhost:3000            product site
#   admin.localhost:3000      Super Admin
#   <institute>.localhost:3000  institute public page (/), sign-in (/login), app (/app)
APP_BASE_DOMAIN=localhost:3000
PLATFORM_HOST=admin.localhost:3000

# Uploaded files (photos, logos). Only the local-disk driver exists. Defaults shown.
# STORAGE_DRIVER=local
# STORAGE_LOCAL_DIR=./storage
